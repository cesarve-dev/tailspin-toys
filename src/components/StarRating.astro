---
import { formatRatingScore, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
    showNoRating?: boolean;
}

const { rating, showNoRating = false } = Astro.props;
---

{(rating !== null || showNoRating) && (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            {rating !== null ? (
                <>
                    <span class="text-yellow-400">{formatStarRating(rating)}</span>
                    <span class="ml-1">{formatRatingScore(rating)}</span>
                </>
            ) : formatRatingScore(rating)}
        </span>
    </div>
)}
